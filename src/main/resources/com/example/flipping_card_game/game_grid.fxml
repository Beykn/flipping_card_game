<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      prefHeight="153.0"
      prefWidth="274.0"
      spacing="15.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.flipping_card_game.GameGridController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Kullanıcı Bilgi Çubuğu (Timer ve Yanlış Sayısı) -->
    <HBox alignment="CENTER" prefHeight="18.0" prefWidth="139.0" spacing="30.0">
        <Label fx:id="timerLabel"
               style="-fx-font-size: 14px; -fx-font-weight: bold;"
               text="Time: 0s" />
        <Label fx:id="wrongAttemptsLabel"
               style="-fx-font-size: 14px; -fx-font-weight: bold;"
               text="Wrong Attempts: 0" />
    </HBox>

    <!-- Durum Mesajı -->
    <Label fx:id="statusLabel"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"
           text="Game started! Select a card." />

    <!-- Kontrol Butonları -->
    <HBox alignment="CENTER" spacing="15.0">
        <Button fx:id="resetButton"
                alignment="CENTER"
                mnemonicParsing="false"
                onAction="#handleResetButton"
                prefHeight="30.0"
                prefWidth="120.0"
                style="-fx-font-size: 14px; -fx-background-color: #f1a0d5; -fx-text-fill: white; -fx-font-weight: bold;"
                text="Reset" />

        <Button fx:id="mainMenuButton"
                alignment="CENTER"
                mnemonicParsing="false"
                onAction="#handleMainMenuButton"
                prefHeight="30.0"
                prefWidth="120.0"
                style="-fx-font-size: 14px; -fx-background-color: #7dbef6; -fx-text-fill: white; -fx-font-weight: bold;"
                text="Main Menu" />
    </HBox>

    <!-- Kart Matrisi -->
    <GridPane fx:id="cardGrid"
              alignment="CENTER"
              hgap="10.0"
              vgap="10.0"
              VBox.vgrow="ALWAYS" />

</VBox>