<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.flipping_card_game.GameGridController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Kullanıcı Bilgi Çubuğu (Timer ve Yanlış Sayısı) -->
    <HBox alignment="CENTER" spacing="30.0">
        <Label fx:id="timerLabel" text="Time: 0s" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        <Label fx:id="wrongAttemptsLabel" text="Wrong Attempts: 0" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    </HBox>

    <Label fx:id="statusLabel" text="Game started! Select a card." style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane fx:id="cardGrid" VBox.vgrow="ALWAYS" alignment="CENTER" hgap="10.0" vgap="10.0"/>
</VBox>